#!/usr/bin/env python3
"""Simulated detached launcher. It demonstrates no real systemd guarantee."""
import json,os,subprocess,sys
from pathlib import Path
args=sys.argv[1:];start=next(i for i,a in enumerate(args) if not a.startswith('--'))
command=args[start:]
if os.environ.get('REMOTE_FAIL_START')=='1':raise SystemExit(1)
base=Path(os.environ['REMOTE_MANAGER_LOG']);base.parent.mkdir(parents=True,exist_ok=True)
with (base.parent/'launcher.log').open('ab') as output:
    process=subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=output,stderr=output,start_new_session=True)
with base.open('a') as f:f.write(json.dumps({'pid':process.pid,'argv':command})+'\n')
