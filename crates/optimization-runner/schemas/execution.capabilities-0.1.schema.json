    "execution_record_schema": {
      "const": "execution.record/0.1"
    },
    "execution_record_publication": {
      "const": "terminal"
    },
    "command_jobs": {
      "const": false
    },
    "generic_file_transfer": {
      "const": false
    },
    "fleet": {
