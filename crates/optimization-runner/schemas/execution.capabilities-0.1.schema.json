{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optimization-jobs:schema:execution.capabilities-0.1",
  "title": "execution.capabilities/0.1",
  "description": "Implemented runner capabilities, not node resource availability or a future-feature promise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_version",
    "execution_kinds",
    "job_schemas",
    "worker_protocols",
    "optimization_result_schema",
    "execution_record_schema",
    "execution_record_publication",
    "command_jobs",
    "generic_file_transfer",
