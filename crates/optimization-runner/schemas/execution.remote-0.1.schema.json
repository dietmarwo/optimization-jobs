{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optimization-jobs:schema:execution.remote-0.1",
  "title": "execution.remote/0.1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "execution.remote/0.1"
        },
        "root": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 4096
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "describe"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "put"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                }
              },
              "required": [
                "kind",
                "sha256",
                "bytes"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "submit"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "identity": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "spec": {
                  "type": "object"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/blob"
                  },
                  "maxItems": 128
                },
                "worker": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "dispatch_id",
                "identity",
                "spec",
                "inputs",
                "worker"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "lookup"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "dispatch_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "cancel"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "immediate": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "dispatch_id",
                "immediate"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "execution"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "dispatch_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "repair"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "dispatch_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "inspect"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "selection": {
                  "$ref": "#/$defs/selection"
                }
              },
              "required": [
                "kind",
                "dispatch_id",
                "selection"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "download"
                },
                "dispatch_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "selection": {
                  "$ref": "#/$defs/selection"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "dispatch_id",
                "selection",
                "bytes",
                "sha256"
              ]
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "root",
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "execution.remote/0.1"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ]
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "result",
        "error"
      ],
      "oneOf": [
        {
          "properties": {
            "error": {
              "type": "null"
            },
            "result": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "error": {
              "type": "object"
            },
            "result": {
              "type": "null"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "index",
        "bytes",
        "sha256"
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "native"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "execution"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "output"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    }
  },
  "description": "One UTF-8 JSON line, at most 4 MiB including newline. Put appends raw bytes; download success appends raw bytes. EOF closes the frame/body. Every non-describe request requires the pinned node_id at runtime. SSH/control timeout is independent from job deadline."
}
