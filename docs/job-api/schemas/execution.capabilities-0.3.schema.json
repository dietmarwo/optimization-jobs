{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optimization-jobs:schema:execution.capabilities-0.3",
  "title": "execution.capabilities/0.3",
  "description": "Implemented runner capabilities, not node resource availability or a future-feature promise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_version",
    "execution_kinds",
    "job_schemas",
    "worker_protocols",
    "optimization_result_schema",
    "execution_record_schema",
    "execution_record_publication",
    "command_jobs",
    "generic_file_transfer",
    "fleet",
    "legacy_fcmaes_result_schema",
    "enabled_execution_kinds",
    "command_result_schema",
    "command_interface",
    "file_transfer_interface",
    "command_isolation",
    "cpu_enforcement",
    "max_file_bytes",
    "max_declared_job_bytes",
    "fleet_interface",
    "fleet_placement",
    "remote_protocol",
    "remote_launcher"
  ],
  "properties": {
    "schema_version": {
      "const": "execution.capabilities/0.3"
    },
    "runner_version": {
      "type": "string",
      "minLength": 1
    },
    "execution_kinds": {
      "const": [
        "optimization",
        "command"
      ]
    },
    "job_schemas": {
      "const": [
        "optimization.job/0.1",
        "fcmaes.job/0.1",
        "execution.command/0.1"
      ]
    },
    "worker_protocols": {
      "const": [
        "optimization.worker/0.1",
        "optimization.worker/0.2",
        "fcmaes.worker/0.1"
      ]
    },
    "optimization_result_schema": {
      "const": "optimization.result/0.2"
    },
    "execution_record_schema": {
      "const": "execution.record/0.1"
    },
    "execution_record_publication": {
      "const": "terminal"
    },
    "command_jobs": {
      "type": "boolean"
    },
    "generic_file_transfer": {
      "const": true
    },
    "fleet": {
      "const": true
    },
    "legacy_fcmaes_result_schema": {
      "const": 1
    },
    "enabled_execution_kinds": {
      "enum": [
        [
          "optimization"
        ],
        [
          "optimization",
          "command"
        ]
      ]
    },
    "command_result_schema": {
      "const": "execution.command.result/0.1"
    },
    "command_interface": {
      "const": "cli"
    },
    "file_transfer_interface": {
      "const": "cli"
    },
    "command_isolation": {
      "const": "trusted_same_user_process_group"
    },
    "cpu_enforcement": {
      "const": "admission_only"
    },
    "max_file_bytes": {
      "const": 67108864
    },
    "max_declared_job_bytes": {
      "const": 268435456
    },
    "fleet_interface": {
      "const": "cli"
    },
    "fleet_placement": {
      "const": "explicit"
    },
    "remote_protocol": {
      "const": "execution.remote/0.1"
    },
    "remote_launcher": {
      "const": "systemd_user_linger"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_jobs": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "enabled_execution_kinds": {
            "const": [
              "optimization",
              "command"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "enabled_execution_kinds": {
            "const": [
              "optimization"
            ]
          }
        }
      }
    }
  ]
}
